#extend("layout"):
    #export("content"):
        <section class="cert-page">
            <div class="site-container" style="max-width:600px; text-align:center;">
                <div style="font-size:3rem; margin-bottom:16px;">&#127881;</div>
                <h1 style="font-size:1.75rem; font-weight:700; margin-bottom:12px;">Welcome to Academy Pro</h1>
                <p style="color:var(--text-muted); margin-bottom:24px; line-height:1.6;">Your subscription is active. You now have full access to all 520+ lessons across 52 courses &mdash; plus verified certificates and PDF downloads.</p>
                <div style="display:flex; gap:12px; justify-content:center;">
                    <a href="/academy" class="cert-share-btn" style="text-decoration:none;">Start Learning</a>
                    <a href="/account/" class="cert-share-btn cert-share-copy" style="text-decoration:none;">My Account</a>
                </div>
            </div>
        </section>
    #endexport
#endextend
