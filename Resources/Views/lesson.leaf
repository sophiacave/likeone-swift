#extend("layout"):
    #export("content"):
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://likeone.ai/"},
                {"@type": "ListItem", "position": 2, "name": "Academy", "item": "https://likeone.ai/academy/"},
                {"@type": "ListItem", "position": 3, "name": "#(courseTitle)", "item": "https://likeone.ai/academy/#(courseSlug)/"},
                {"@type": "ListItem", "position": 4, "name": "#(lessonTitle)"}
            ]
        }
        </script>
        <div class="lesson-topbar">
            <div class="reading-column" style="display: flex; justify-content: space-between; align-items: center;">
                <a href="/academy/#(courseSlug)" class="lesson-topbar-course">
                    <span class="lesson-topbar-emoji">#(courseEmoji)</span>
                    #(courseTitle)
                </a>
                <span class="lesson-topbar-pos">Lesson #(lessonOrder) of #(totalLessons)</span>
            </div>
        </div>

        <article class="lesson-article">
            <div class="reading-column">
                <h1 class="lesson-page-title">#(lessonTitle)</h1>

                #if(isLocked):
                    <!-- Pro paywall -->
                    <div style="text-align:center;padding:60px 20px;margin:40px 0;">
                        <div style="font-size:2.5rem;margin-bottom:16px;opacity:.5;">&#x1F512;</div>
                        <h2 style="font-size:1.25rem;font-weight:700;margin-bottom:8px;color:var(--text-primary);">This lesson requires Academy Pro</h2>
                        <p style="color:var(--text-secondary);margin-bottom:24px;max-width:400px;margin-left:auto;margin-right:auto;line-height:1.6;">The first 3 lessons in every course are free. Upgrade to Pro to unlock all 520+ lessons, earn certificates, and support free AI education.</p>
                        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                            <a href="/pricing" class="site-btn-primary" style="text-decoration:none;">Upgrade to Pro &mdash; $19/mo</a>
                            <a href="/signin/" class="site-btn-secondary" style="text-decoration:none;">Sign In</a>
                        </div>
                        <p style="font-size:.75rem;color:var(--text-muted);margin-top:16px;">Already Pro? <a href="/signin/" style="color:var(--purple-400);">Sign in</a> to access this lesson.</p>
                    </div>
                #else:
                    <h2 class="sr-only">Lesson Content</h2>
                    <div class="article-content lesson-content">
                        #unsafeHTML(content)
                    </div>
                #endif

                <nav class="lesson-nav" aria-label="Lesson navigation">
                    #if(prevSlug):
                        <a href="/academy/#(courseSlug)/#(prevSlug)" class="lesson-nav-btn lesson-nav-prev">
                            <span class="lesson-nav-label">&larr; Previous</span>
                            <span class="lesson-nav-title">#(prevTitle)</span>
                        </a>
                    #else:
                        <div></div>
                    #endif
                    #if(nextSlug):
                        <a href="/academy/#(courseSlug)/#(nextSlug)" class="lesson-nav-btn lesson-nav-next">
                            <span class="lesson-nav-label">Next &rarr;</span>
                            <span class="lesson-nav-title">#(nextTitle)</span>
                        </a>
                    #else:
                        <a href="/academy/#(courseSlug)" class="lesson-nav-btn lesson-nav-next">
                            <span class="lesson-nav-label">Done &check;</span>
                            <span class="lesson-nav-title">Back to Course</span>
                        </a>
                    #endif
                </nav>

                <!-- Brain-powered recommendations (Phase 4) -->
                <div hx-get="/api/v1/recommend?topic=#(courseTitle) #(lessonTitle)&limit=3&exclude=#(courseSlug)" hx-trigger="load" hx-swap="innerHTML"></div>
            </div>
        </article>
    #endexport
#endextend
