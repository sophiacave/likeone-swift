<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#c084fc">
    <title>#(title)</title>
    <meta name="description" content="#(description)">
    <meta property="og:title" content="#(title)">
    <meta property="og:description" content="#(description)">
    <meta property="og:type" content="#if(ogType):#(ogType)#else:website#endif">
    <meta property="og:site_name" content="Like One">
    #if(ogUrl):<meta property="og:url" content="#(ogUrl)">#endif
    #if(ogImage):<meta property="og:image" content="#(ogImage)">#endif
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="#(title)">
    <meta name="twitter:description" content="#(description)">
    #if(ogImage):<meta name="twitter:image" content="#(ogImage)">#endif
    #if(canonicalUrl):<link rel="canonical" href="#(canonicalUrl)">#endif
    <link rel="alternate" type="application/rss+xml" title="Like One Blog RSS" href="https://likeone.ai/feed.xml">
    <link rel="stylesheet" href="/css/style.css?v=271">
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Like One",
        "alternateName": ["Like One Academy", "likeone.ai"],
        "url": "https://likeone.ai",
        "logo": "https://likeone.ai/images/logo.png",
        "description": "AI education from a 501(c)(3) nonprofit. 50+ courses, 590+ lessons. Start free.",
        "sameAs": [
            "https://github.com/sophiacave/likeone-swift",
            "https://github.com/sophiacave/sovereign-brain",
            "https://github.com/sophiacave/mcp-shield",
            "https://github.com/sophiacave/claude-brain",
            "https://bsky.app/profile/likeone.bsky.social"
        ],
        "founder": {
            "@type": "Person",
            "name": "Sophia Cave"
        },
        "nonprofitStatus": "Nonprofit501c3",
        "contactPoint": {
            "@type": "ContactPoint",
            "email": "hello@likeone.ai",
            "contactType": "customer support"
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Like One",
        "url": "https://likeone.ai",
        "potentialAction": {
            "@type": "SearchAction",
            "target": "https://likeone.ai/search?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
    <script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
</head>
<body>
    <div class="site-page">
        <a href="#main-content" class="skip-link">Skip to content</a>
        <header class="header-site">
            <nav class="header-site-nav" aria-label="Main navigation">
                <a class="header-site-brand" href="/">like<span class="accent">one</span></a>
                <button class="mobile-menu-btn" aria-label="Menu" onclick="document.querySelector('.site-nav-links').classList.toggle('nav-open');">&#9776;</button>
                <div class="site-nav-links">
                    <a class="header-site-link" href="/academy">Academy</a>
                    <a class="header-site-link" href="/tracks">Tracks</a>
                    <a class="header-site-link" href="/blog">Blog</a>
                    <a class="header-site-link" href="/about">About</a>
                    <a class="header-site-link" href="/consulting">Consulting</a>
                    <a class="header-site-link" href="/search" aria-label="Search">&#x1F50D;</a>
                    <a class="header-signin-btn" href="/signin" id="auth-btn">Sign In</a>
                </div>
            </nav>
        </header>
        <main id="main-content">
            #import("content")
        </main>
        <footer class="footer-site">
            <div class="footer-grid">
                <div class="footer-col">
                    <div class="footer-col-title">Academy</div>
                    <a href="/academy" class="footer-link">Courses</a>
                    <a href="/tracks" class="footer-link">Tracks</a>
                    <a href="/pricing" class="footer-link">Pricing</a>
                    <a href="/signin" class="footer-link">Sign In</a>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">Company</div>
                    <a href="/about" class="footer-link">About</a>
                    <a href="/foundation" class="footer-link">Foundation</a>
                    <a href="/blog" class="footer-link">Blog</a>
                    <a href="/consulting" class="footer-link">Consulting</a>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">Open Source</div>
                    <a href="https://github.com/sophiacave/mcp-shield" class="footer-link" target="_blank" rel="noopener">MCP Shield</a>
                    <a href="https://github.com/sophiacave/orchard-hig" class="footer-link" target="_blank" rel="noopener">Orchard HIG</a>
                    <a href="https://github.com/sophiacave/orchard-sign" class="footer-link" target="_blank" rel="noopener">Orchard Sign</a>
                    <a href="https://github.com/sophiacave/claude-brain" class="footer-link" target="_blank" rel="noopener">Claude Brain</a>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">Stay Updated</div>
                    <p class="footer-subscribe-desc">AI education updates. No spam.</p>
                    <form hx-post="/api/subscribe" hx-target="#subscribe-result" hx-swap="innerHTML" class="footer-subscribe-form">
                        <input type="hidden" name="sourcePage" value="/">
                        <input type="email" name="email" placeholder="your@email.com" required class="footer-subscribe-input">
                        <button type="submit" class="footer-subscribe-btn">Subscribe</button>
                    </form>
                    <div id="subscribe-result"></div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 Like One LLC. All rights reserved.</span>
                <span class="footer-bottom-links">
                    <a href="/privacy">Privacy</a>
                    <a href="/terms">Terms</a>
                    <a href="mailto:hello@likeone.ai">hello@likeone.ai</a>
                </span>
            </div>
        </footer>
    </div>
    <script>
    // Set subscribe form source page
    var sp = document.querySelector('[name=sourcePage]');
    if (sp) sp.value = window.location.pathname;

    /* Progress tracking: localStorage + server sync — defined FIRST so auth code can use it */
    var LOP = {
        key: 'lo_progress',
        _authed: null,
        get: function() { try { return JSON.parse(localStorage.getItem(this.key)) || {}; } catch(e) { return {}; } },
        save: function(data) { localStorage.setItem(this.key, JSON.stringify(data)); },
        mark: function(courseSlug, lessonSlug) {
            var d = this.get();
            if (!d[courseSlug]) d[courseSlug] = [];
            if (d[courseSlug].indexOf(lessonSlug) === -1) d[courseSlug].push(lessonSlug);
            this.save(d);
            this.syncToServer(courseSlug, lessonSlug);
        },
        isDone: function(courseSlug, lessonSlug) {
            var d = this.get();
            return d[courseSlug] && d[courseSlug].indexOf(lessonSlug) !== -1;
        },
        count: function(courseSlug) {
            var d = this.get();
            return d[courseSlug] ? d[courseSlug].length : 0;
        },
        syncToServer: function(courseSlug, lessonSlug) {
            fetch('/api/v1/progress/complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courseSlug: courseSlug, lessonSlug: lessonSlug }),
                credentials: 'same-origin'
            }).then(function(r) {
                if (r.status === 401) {
                    LOP.handleSessionExpired();
                    return null;
                }
                if (!r.ok) return null;
                LOP._authed = true;
                return r.json();
            }).then(function(data) {
                if (!data) return;
                if (data.courseComplete && !data.needsPro) {
                    LOP.showCourseComplete(courseSlug);
                }
                if (data.needsPro) {
                    LOP.showUpgradePrompt();
                }
                if (data.trackCompleted) {
                    LOP.showTrackComplete(data.trackCompleted);
                }
            }).catch(function() {});
        },
        loadFromServer: function(courseSlug) {
            fetch('/api/v1/progress/course/' + courseSlug, { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(data) {
                if (!data) return;
                LOP._authed = true;
                var d = LOP.get();
                if (!d[courseSlug]) d[courseSlug] = [];
                data.completedLessons.forEach(function(ls) {
                    if (d[courseSlug].indexOf(ls) === -1) d[courseSlug].push(ls);
                });
                LOP.save(d);
                LOP.refreshUI();
            }).catch(function() {});
        },
        showCourseComplete: function(courseSlug) {
            var toast = document.createElement('div');
            toast.className = 'lo-toast lo-toast-success';
            toast.innerHTML = '<strong>Course complete!</strong> You earned a certificate.';
            document.body.appendChild(toast);
            setTimeout(function() { toast.classList.add('lo-toast-show'); }, 10);
            setTimeout(function() { toast.remove(); }, 5000);
        },
        showUpgradePrompt: function() {
            var toast = document.createElement('div');
            toast.className = 'lo-toast lo-toast-success';
            toast.innerHTML = '<strong>Course complete!</strong> <a href="/pricing" style="color:#c084fc;text-decoration:underline;">Upgrade to Pro</a> to earn your certificate.';
            document.body.appendChild(toast);
            setTimeout(function() { toast.classList.add('lo-toast-show'); }, 10);
            setTimeout(function() { toast.remove(); }, 8000);
        },
        showTrackComplete: function(trackSlug) {
            var toast = document.createElement('div');
            toast.className = 'lo-toast lo-toast-gold';
            toast.innerHTML = '<strong>Track complete!</strong> You earned a learning track certificate!';
            document.body.appendChild(toast);
            setTimeout(function() { toast.classList.add('lo-toast-show'); }, 10);
            setTimeout(function() { toast.remove(); }, 6000);
        },
        handleSessionExpired: function() {
            if (LOP._expiredShown) return;
            LOP._expiredShown = true;
            document.cookie = 'lo_authed=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
            var toast = document.createElement('div');
            toast.className = 'lo-toast lo-toast-success';
            toast.innerHTML = 'Session expired. <a href="/signin" style="color:#c084fc;text-decoration:underline;font-weight:600;">Sign in again</a> to save your progress.';
            document.body.appendChild(toast);
            setTimeout(function() { toast.classList.add('lo-toast-show'); }, 10);
            var authBtn = document.getElementById('auth-btn');
            if (authBtn) { authBtn.href = '/signin'; authBtn.textContent = 'Sign In'; }
        },
        refreshUI: function() {
            document.querySelectorAll('.lesson-row').forEach(function(row) {
                var href = row.getAttribute('href');
                if (!href) return;
                var parts = href.split('/');
                if (parts.length >= 4 && LOP.isDone(parts[2], parts[3]) && !row.classList.contains('lesson-done')) {
                    row.classList.add('lesson-done');
                    var right = row.querySelector('.lesson-row-right');
                    if (right && !right.querySelector('.lesson-done-check')) {
                        var check = document.createElement('span');
                        check.className = 'lesson-done-check';
                        check.textContent = '\u2714';
                        right.prepend(check);
                    }
                }
            });
        }
    };

    // Auth state: swap Sign In → Account if authenticated
    var isAuthed = document.cookie.indexOf('lo_authed=1') !== -1;
    if (isAuthed) {
        var authBtn = document.getElementById('auth-btn');
        if (authBtn) { authBtn.href = '/account'; authBtn.textContent = 'Account'; }

        // Session validity check — verify lo_session cookie still works
        if (!sessionStorage.getItem('session_checked')) {
            fetch('/api/v1/progress/all', { credentials: 'same-origin' })
            .then(function(r) {
                if (r.status === 401) { LOP.handleSessionExpired(); return null; }
                sessionStorage.setItem('session_checked', '1');
                return r.ok ? r.json() : null;
            }).catch(function() {});
        }

        // Cross-device sync: load all server progress once per session
        if (!sessionStorage.getItem('progress_loaded')) {
            fetch('/api/v1/progress/all', { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(serverProgress) {
                if (!serverProgress) return;
                var local = LOP.get();
                var merged = false;
                for (var course in serverProgress) {
                    if (!local[course]) local[course] = [];
                    serverProgress[course].forEach(function(ls) {
                        if (local[course].indexOf(ls) === -1) {
                            local[course].push(ls);
                            merged = true;
                        }
                    });
                }
                if (merged) { LOP.save(local); LOP.refreshUI(); }
                sessionStorage.setItem('progress_loaded', '1');
            }).catch(function() {});
        }

        // Auth migration: upload orphaned localStorage progress to server
        if (!sessionStorage.getItem('progress_synced')) {
            var local = LOP.get();
            var items = [];
            for (var course in local) {
                local[course].forEach(function(ls) {
                    items.push({ courseSlug: course, lessonSlug: ls });
                });
            }
            if (items.length > 0) {
                fetch('/api/v1/progress/sync', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(items),
                    credentials: 'same-origin'
                }).then(function(r) {
                    if (r.ok) sessionStorage.setItem('progress_synced', '1');
                }).catch(function() {});
            } else {
                sessionStorage.setItem('progress_synced', '1');
            }
        }
    }

    document.addEventListener('click', function(e) {
        if (e.target.closest('.academy-filter-btn')) {
            document.querySelectorAll('.academy-filter-btn').forEach(function(b) { b.classList.remove('active'); });
            e.target.closest('.academy-filter-btn').classList.add('active');
        }
    });

    /* Count-up animation for stats */
    function countUp(el, target, duration) {
        var start = 0, startTime = null;
        function step(ts) {
            if (!startTime) startTime = ts;
            var progress = Math.min((ts - startTime) / duration, 1);
            var ease = 1 - Math.pow(1 - progress, 3);
            el.textContent = el.dataset.prefix + Math.floor(ease * target) + el.dataset.suffix;
            if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
    }

    /* Hero parallax via scroll */
    function initParallax() {
        var hero = document.querySelector('.site-hero-inner');
        if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(function() {
                    var y = window.scrollY;
                    if (y < 800) {
                        hero.style.transform = 'translateY(' + (y * 0.15) + 'px)';
                        hero.style.opacity = Math.max(1 - y / 600, 0);
                    }
                    ticking = false;
                });
            }
        }, { passive: true });
    }

    /* Quiz Score Counter + Flashcard Study Mode */
    document.addEventListener('DOMContentLoaded', function() {
        initParallax();

        // Progress: Mark complete on lesson pages
        var lessonNav = document.querySelector('.lesson-nav');
        var topbar = document.querySelector('.lesson-topbar-course');
        if (lessonNav && topbar) {
            var path = window.location.pathname.split('/');
            // /academy/{courseSlug}/{lessonSlug}
            if (path.length >= 4 && path[1] === 'academy') {
                var cs = path[2], ls = path[3];

                // Add completion bar before nav — quiz-aware
                var bar = document.createElement('div');
                bar.className = 'lesson-complete-bar';
                var hasQuiz = document.querySelector('.quiz-block') !== null;
                if (LOP.isDone(cs, ls)) {
                    bar.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Lesson Complete';
                    bar.classList.add('completed');
                } else if (hasQuiz) {
                    bar.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><circle cx="12" cy="17" r=".5"/></svg> Pass the quiz to complete this lesson';
                    bar.classList.add('quiz-gate');
                } else {
                    bar.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Mark as Complete';
                    bar.addEventListener('click', function() {
                        LOP.mark(cs, ls);
                        bar.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Lesson Complete';
                        bar.classList.add('completed');
                    });
                }
                lessonNav.parentNode.insertBefore(bar, lessonNav);

                // Auto-mark when clicking Next lesson link
                lessonNav.addEventListener('click', function(ev) {
                    var link = ev.target.closest('.lesson-nav-btn');
                    if (link) LOP.mark(cs, ls);
                });
            }
        }

        // Progress: Show checkmarks on course detail pages
        document.querySelectorAll('.lesson-row').forEach(function(row) {
            var href = row.getAttribute('href');
            if (!href) return;
            var parts = href.split('/');
            if (parts.length >= 4) {
                var cs = parts[2], ls = parts[3];
                if (LOP.isDone(cs, ls)) {
                    row.classList.add('lesson-done');
                    var right = row.querySelector('.lesson-row-right');
                    if (right) {
                        var check = document.createElement('span');
                        check.className = 'lesson-done-check';
                        check.textContent = '\u2714';
                        right.prepend(check);
                    }
                }
            }
        });

        // Server sync: merge server progress into localStorage (if authenticated)
        (function() {
            var path = window.location.pathname.split('/');
            if (path.length >= 3 && path[1] === 'academy') {
                LOP.loadFromServer(path[2]);
            }
        })();

        // Progress: Show progress bar on course cards
        document.querySelectorAll('.course-card').forEach(function(card) {
            var href = card.getAttribute('href');
            if (!href) return;
            var slug = href.replace('/academy/', '').replace('/', '');
            var done = LOP.count(slug);
            if (done > 0) {
                var meta = card.querySelector('.course-card-meta');
                if (meta) {
                    var lessonsText = card.querySelector('.course-card-lessons');
                    var total = lessonsText ? parseInt(lessonsText.textContent) || 10 : 10;
                    var pct = Math.min(Math.round((done / total) * 100), 100);
                    var pbar = document.createElement('div');
                    pbar.innerHTML = '<div class="course-progress-bar"><div class="course-progress-fill" style="width:' + pct + '%"></div></div><div class="course-progress-text">' + done + ' of ' + total + ' complete</div>';
                    meta.parentNode.insertBefore(pbar, meta.nextSibling);
                }
            }
        });

        // Stats count-up on scroll into view
        var statEls = document.querySelectorAll('.site-stat-number');
        if (statEls.length > 0) {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (!entry.isIntersecting) return;
                    var el = entry.target;
                    if (el.dataset.counted) return;
                    el.dataset.counted = '1';
                    var text = el.textContent.trim();
                    var prefix = text.match(/^[^0-9]*/)[0] || '';
                    var suffix = text.match(/[^0-9]*$/)[0] || '';
                    var num = parseInt(text.replace(/[^0-9]/g, ''), 10);
                    el.dataset.prefix = prefix;
                    el.dataset.suffix = suffix;
                    if (num > 0) {
                        el.textContent = prefix + '0' + suffix;
                        countUp(el, num, 1200);
                    }
                    observer.unobserve(el);
                });
            }, { threshold: 0.5 });
            statEls.forEach(function(el) { observer.observe(el); });
        }

        // UNIFIED QUIZ ENGINE — merges ALL quiz-blocks into ONE sequential quiz
        (function() {
            var blocks = document.querySelectorAll('.quiz-block');
            if (blocks.length === 0) return;

            // Collect ALL questions from ALL quiz-blocks
            var allQuestions = [];
            blocks.forEach(function(block) {
                block.querySelectorAll('.quiz-question').forEach(function(q) {
                    allQuestions.push(q);
                });
            });
            if (allQuestions.length === 0) return;

            // Hide original quiz-blocks
            blocks.forEach(function(block) { block.style.display = 'none'; });

            // Create unified quiz container
            var unified = document.createElement('div');
            unified.className = 'quiz-block quiz-sequential quiz-unified';
            unified.innerHTML = '<h3 class="quiz-title">Test Your Knowledge</h3>';

            // Move all questions into unified container
            allQuestions.forEach(function(q) { unified.appendChild(q); });

            // Re-number questions
            allQuestions.forEach(function(q, i) {
                var num = q.querySelector('.quiz-num');
                if (num) num.textContent = i + 1;
            });

            // Insert before lesson-complete-bar or lesson-nav
            var anchor = document.querySelector('.lesson-complete-bar') || document.querySelector('.lesson-nav');
            if (anchor && anchor.parentNode) {
                anchor.parentNode.insertBefore(unified, anchor);
            } else {
                var content = document.querySelector('.lesson-content');
                if (content) content.parentNode.insertBefore(unified, content.nextSibling);
            }

            // State
            var currentIdx = 0, correct = 0, wrong = 0, answered = {};

            // Progress dots
            var progressEl = document.createElement('div');
            progressEl.className = 'quiz-progress';
            var dotsHtml = '';
            for (var d = 0; d < allQuestions.length; d++) {
                dotsHtml += '<div class="quiz-dot' + (d === 0 ? ' dot-current' : '') + '"></div>';
            }
            progressEl.innerHTML = '<span class="quiz-progress-text">Question 1 of ' + allQuestions.length + '</span>' +
                '<div class="quiz-progress-dots">' + dotsHtml + '</div>';
            unified.querySelector('.quiz-title').after(progressEl);

            var dots = progressEl.querySelectorAll('.quiz-dot');
            var progText = progressEl.querySelector('.quiz-progress-text');

            // Score bar
            var scoreEl = document.createElement('div');
            scoreEl.className = 'quiz-score';
            scoreEl.innerHTML = '<span class="quiz-score-label">Score</span>' +
                '<span class="quiz-score-correct">0</span>' +
                '<span class="quiz-score-divider">/</span>' +
                '<span class="quiz-score-wrong">0</span>' +
                '<span class="quiz-score-total">of ' + allQuestions.length + '</span>' +
                '<div class="quiz-score-bar"><div class="quiz-score-fill"></div></div>';
            progressEl.after(scoreEl);

            // Next button
            var nextBtn = document.createElement('button');
            nextBtn.className = 'quiz-next-btn';
            nextBtn.textContent = 'Next Question \u2192';

            function showQuestion(idx) {
                allQuestions.forEach(function(q) { q.classList.remove('quiz-active'); });
                if (idx < allQuestions.length) {
                    allQuestions[idx].classList.add('quiz-active');
                    progText.textContent = 'Question ' + (idx + 1) + ' of ' + allQuestions.length;
                    dots.forEach(function(dot, i) { dot.classList.toggle('dot-current', i === idx); });
                    nextBtn.classList.remove('visible');
                    allQuestions[idx].appendChild(nextBtn);
                } else {
                    // Quiz complete
                    var pct = Math.round((correct / allQuestions.length) * 100);
                    var passed = pct >= 80;
                    var msg = document.createElement('div');
                    msg.className = 'quiz-complete-msg' + (passed ? ' quiz-passed' : ' quiz-failed');

                    if (passed) {
                        var qpath = window.location.pathname.replace(/\/$/, '').split('/');
                        if (qpath.length >= 4 && qpath[1] === 'academy') {
                            LOP.mark(qpath[2], qpath[3]);
                            var bar = document.querySelector('.lesson-complete-bar');
                            if (bar) {
                                bar.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Lesson Complete';
                                bar.classList.add('completed');
                            }
                        }
                        msg.innerHTML = '<div class="quiz-pass-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div>' +
                            (wrong === 0 ? '<strong>Perfect score!</strong> ' : '<strong>' + correct + ' of ' + allQuestions.length + '</strong> correct ') +
                            '(' + pct + '%)<div class="quiz-pass-label">Lesson Complete</div>';
                    } else {
                        msg.innerHTML = '<div class="quiz-fail-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></div>' +
                            '<strong>' + correct + ' of ' + allQuestions.length + '</strong> correct (' + pct + '%)<div class="quiz-fail-label">Score 80% or higher to complete this lesson</div>';
                    }

                    var retryBtn = document.createElement('button');
                    retryBtn.className = 'quiz-next-btn visible';
                    retryBtn.textContent = passed ? 'Review Again' : 'Try Again';
                    retryBtn.style.marginTop = '12px';
                    retryBtn.addEventListener('click', function() {
                        correct = 0; wrong = 0; currentIdx = 0; answered = {};
                        scoreEl.querySelector('.quiz-score-correct').textContent = '0';
                        scoreEl.querySelector('.quiz-score-wrong').textContent = '0';
                        scoreEl.querySelector('.quiz-score-fill').style.width = '0%';
                        scoreEl.classList.remove('quiz-score-perfect');
                        dots.forEach(function(dot) { dot.className = 'quiz-dot'; });
                        allQuestions.forEach(function(q) {
                            q.querySelectorAll('.quiz-option').forEach(function(opt) {
                                opt.classList.remove('quiz-correct', 'quiz-wrong');
                                opt.style.pointerEvents = '';
                            });
                            q.querySelectorAll('.quiz-options').forEach(function(opts) { opts.classList.remove('revealed'); });
                            q.querySelectorAll('.quiz-explanation').forEach(function(exp) { exp.style.display = 'none'; });
                        });
                        if (msg.parentNode) msg.remove();
                        if (retryBtn.parentNode) retryBtn.remove();
                        showQuestion(0);
                    });
                    unified.appendChild(msg);
                    unified.appendChild(retryBtn);
                    progText.textContent = 'Complete';
                    if (wrong === 0) scoreEl.classList.add('quiz-score-perfect');
                }
            }

            showQuestion(0);

            nextBtn.addEventListener('click', function() {
                currentIdx++;
                showQuestion(currentIdx);
            });

            unified.addEventListener('click', function(ev) {
                var btn = ev.target.closest('.quiz-option');
                if (!btn) return;
                if (answered[currentIdx]) return;
                answered[currentIdx] = true;

                var isCorrect = btn.classList.contains('quiz-correct');
                if (isCorrect) {
                    correct++;
                    dots[currentIdx].classList.remove('dot-current');
                    dots[currentIdx].classList.add('dot-correct');
                } else {
                    wrong++;
                    dots[currentIdx].classList.remove('dot-current');
                    dots[currentIdx].classList.add('dot-wrong');
                }

                scoreEl.querySelector('.quiz-score-correct').textContent = correct;
                scoreEl.querySelector('.quiz-score-wrong').textContent = wrong;
                var pct = Math.round((correct / allQuestions.length) * 100);
                scoreEl.querySelector('.quiz-score-fill').style.width = pct + '%';

                if (currentIdx < allQuestions.length - 1) {
                    nextBtn.textContent = 'Next Question \u2192';
                } else {
                    nextBtn.textContent = 'See Results';
                }
                nextBtn.classList.add('visible');
            });
        })();

        // Flashcard study mode
        document.querySelectorAll('.flash-block').forEach(function(block) {
            var cards = block.querySelectorAll('.flash-card');
            if (cards.length < 2) return;

            var title = block.querySelector('.quiz-title');
            var controls = document.createElement('div');
            controls.className = 'flash-study-controls';
            controls.innerHTML = '<button class="flash-study-btn" aria-label="Toggle study mode">Study Mode</button>' +
                '<span class="flash-study-progress"></span>';
            if (title && title.nextSibling) {
                title.parentNode.insertBefore(controls, title.nextSibling);
            } else {
                block.insertBefore(controls, block.firstChild);
            }

            var nav = document.createElement('div');
            nav.className = 'flash-study-nav';
            nav.innerHTML = '<button class="flash-nav-btn flash-prev" aria-label="Previous card" disabled>&larr; Prev</button>' +
                '<button class="flash-nav-btn flash-next" aria-label="Next card">Next &rarr;</button>';
            block.appendChild(nav);

            var idx = 0;
            var btn = controls.querySelector('.flash-study-btn');
            var progress = controls.querySelector('.flash-study-progress');
            var prevBtn = nav.querySelector('.flash-prev');
            var nextBtn = nav.querySelector('.flash-next');

            function updateStudy() {
                cards.forEach(function(c, i) {
                    c.classList.toggle('study-active', i === idx);
                    if (i === idx) c.removeAttribute('open');
                });
                progress.textContent = (idx + 1) + ' / ' + cards.length;
                prevBtn.disabled = idx === 0;
                nextBtn.disabled = idx === cards.length - 1;
            }

            btn.addEventListener('click', function() {
                var active = block.classList.toggle('study-mode');
                btn.classList.toggle('active', active);
                btn.textContent = active ? 'Browse All' : 'Study Mode';
                if (active) {
                    idx = 0;
                    updateStudy();
                } else {
                    progress.textContent = '';
                }
            });

            prevBtn.addEventListener('click', function() {
                if (idx > 0) { idx--; updateStudy(); }
            });
            nextBtn.addEventListener('click', function() {
                if (idx < cards.length - 1) { idx++; updateStudy(); }
            });
        });
    });
    </script>
    <script>
    // Make scrollable visual aids keyboard-accessible (WCAG 2.1.1)
    document.querySelectorAll('.lesson-visual').forEach(function(el) {
        if (el.scrollWidth > el.clientWidth) {
            el.setAttribute('tabindex', '0');
            el.setAttribute('role', 'region');
            if (!el.getAttribute('aria-label')) {
                el.setAttribute('aria-label', 'Scrollable diagram');
            }
        }
    });
    </script>
</body>
</html>
