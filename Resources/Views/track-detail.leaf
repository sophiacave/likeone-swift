#extend("layout"):
    #export("content"):
        <section class="page-hero" style="padding-bottom:32px;">
            <div class="site-container">
                <a href="/tracks" class="track-back-link">&larr; All Tracks</a>
                <div class="track-detail-header">
                    <span class="track-detail-emoji">#(track.emoji)</span>
                    <div>
                        <h1 class="track-detail-title">#(track.title)</h1>
                        <p class="track-detail-desc">#(track.description)</p>
                        <div class="track-detail-meta">
                            <span class="track-detail-badge" style="background:#(track.badgeColor)20;color:#(track.badgeColor);">#(track.difficulty)</span>
                            <span class="track-detail-stat">#(track.courseCount) courses</span>
                            <span class="track-detail-stat">~#(track.estimatedHours) hours</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="site-section" style="padding-top:24px;">
            <div class="site-container" style="max-width:800px;">
                <!-- Track progress bar (server-rendered when authed; JS fills for anonymous) -->
                <div class="track-progress-wrap" id="track-progress" style="display:#if(hasProgress):block#else:none#endif;">
                    <div class="track-progress-label"><span id="track-done">#(completedCourses)</span> of #(track.courseCount) courses complete</div>
                    <div class="track-progress-bar">
                        <div class="track-progress-fill" id="track-fill" style="width:#(trackPct)%;background:#(track.badgeColor);"></div>
                    </div>
                </div>

                <div class="track-courses-list">
                    #for(course in courses):
                        <a href="/academy/#(course.slug)" class="track-course-row#if(course.isComplete): track-course-done#endif" data-course="#(course.slug)">
                            <div class="track-course-num">#(course.order)</div>
                            <div class="track-course-info">
                                <span class="track-course-emoji">#(course.emoji)</span>
                                <div>
                                    <div class="track-course-title">#(course.title)</div>
                                    <div class="track-course-desc">#(course.description)</div>
                                </div>
                            </div>
                            <div class="track-course-status">#if(course.isComplete):<span style="color:var(--green,#34d399);font-weight:700;">&#x2714;</span>#elseif(course.pct > 0):<span style="font-size:.75rem;color:var(--text-muted);">#(course.pct)%</span>#endif</div>
                            <div class="track-course-arrow">&rarr;</div>
                        </a>
                    #endfor
                </div>

                <script>
                (function() {
                    fetch('/api/v1/progress/track/#(track.slug)', { credentials: 'same-origin' })
                    .then(function(r) { return r.ok ? r.json() : null; })
                    .then(function(data) {
                        if (!data) return;
                        var wrap = document.getElementById('track-progress');
                        var doneEl = document.getElementById('track-done');
                        var fill = document.getElementById('track-fill');
                        var done = data.courses.filter(function(c) { return c.isComplete; }).length;
                        var total = data.courses.length;
                        var pct = total > 0 ? Math.round(done / total * 100) : 0;

                        wrap.style.display = '';
                        doneEl.textContent = done;
                        fill.style.width = pct + '%';

                        data.courses.forEach(function(c) {
                            var row = document.querySelector('[data-course="' + c.courseSlug + '"]');
                            if (!row) return;
                            var status = row.querySelector('.track-course-status');
                            if (c.isComplete) {
                                status.innerHTML = '<span style="color:var(--green,#34d399);font-weight:700;">&#x2714;</span>';
                                row.classList.add('track-course-done');
                            } else if (c.completedLessons > 0) {
                                var cp = Math.round(c.completedLessons / c.totalLessons * 100);
                                status.innerHTML = '<span style="font-size:.75rem;color:var(--text-muted);">' + cp + '%</span>';
                            }
                        });

                        if (data.certificateId) {
                            var cta = document.querySelector('.site-section-alt .site-btn-primary');
                            if (cta) {
                                cta.textContent = 'View Certificate';
                                cta.href = '/cert/' + data.certificateId;
                            }
                        }
                    }).catch(function() {
                        // Fallback: use localStorage progress for unauthenticated users
                        showLocalProgress();
                    });

                    function showLocalProgress() {
                        var lp = JSON.parse(localStorage.getItem('lo_progress') || '{}');
                        var rows = document.querySelectorAll('[data-course]');
                        var done = 0, total = rows.length;

                        rows.forEach(function(row) {
                            var slug = row.getAttribute('data-course');
                            var completed = (lp[slug] || []).length;
                            if (completed > 0) {
                                var status = row.querySelector('.track-course-status');
                                fetch('/api/v1/courses/' + slug + '/lessons')
                                .then(function(r) { return r.json(); })
                                .then(function(lessons) {
                                    var pct = Math.round(completed / lessons.length * 100);
                                    if (completed >= lessons.length) {
                                        status.innerHTML = '<span style="color:var(--green,#34d399);font-weight:700;">&#x2714;</span>';
                                        done++;
                                    } else {
                                        status.innerHTML = '<span style="font-size:.75rem;color:var(--text-muted);">' + pct + '%</span>';
                                    }
                                    // Update overall bar
                                    var wrap = document.getElementById('track-progress');
                                    var doneEl = document.getElementById('track-done');
                                    var fill = document.getElementById('track-fill');
                                    if (done > 0 || completed > 0) {
                                        wrap.style.display = '';
                                        doneEl.textContent = done;
                                        fill.style.width = Math.round(done / total * 100) + '%';
                                    }
                                }).catch(function() {});
                            }
                        });
                    }
                })();
                </script>
            </div>
        </section>

        <section class="site-section-alt">
            <div class="site-container text-center" style="padding:48px 20px;">
                <h2 style="font-size:clamp(1.25rem,3vw,1.75rem);font-weight:700;color:var(--text-primary);margin-bottom:12px;">Complete this track. Earn a certificate.</h2>
                <p style="font-size:.95rem;color:var(--text-secondary);max-width:480px;margin:0 auto 24px;line-height:1.6;">Finish all #(track.courseCount) courses and we'll generate a verifiable credential you can share on LinkedIn.</p>
                #if(count(courses) > 0):
                    <a class="site-btn-primary" href="/academy/#(firstCourseSlug)">Start with Course 1</a>
                #endif
            </div>
        </section>
    #endexport
#endextend
