#extend("layout"):
    #export("content"):
        <section class="site-section" style="min-height: 60vh; display: flex; align-items: center;">
            <div class="site-container" style="max-width: 420px; text-align: center;">
                <h1 class="site-section-title" style="margin-bottom: 8px;">Sign In</h1>
                <p style="color: var(--text-secondary); margin-bottom: 40px;">Access your courses, track progress, and earn certificates.</p>

                <!-- Google Sign In (Identity Services) -->
                <div id="google-signin-wrap" class="signin-google-wrap">
                    <div id="g_id_onload"
                         data-client_id="469463762089-i84flm8nn1spmk79qf5kp67pp8u0idlq.apps.googleusercontent.com"
                         data-callback="handleGoogleSignIn"
                         data-auto_prompt="false">
                    </div>
                    <div class="g_id_signin"
                         data-type="standard"
                         data-shape="pill"
                         data-theme="filled_black"
                         data-text="signin_with"
                         data-size="large"
                         data-logo_alignment="left"
                         data-width="320">
                    </div>
                </div>

                <div class="signin-divider">
                    <span>or</span>
                </div>

                <a href="/auth/apple" class="signin-btn signin-apple" aria-label="Sign in with Apple">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                    Sign in with Apple
                </a>

                <div id="signin-error" class="signin-error" style="display:none;"></div>

                <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 32px;">No password required. We use your existing Apple or Google account.</p>
            </div>
        </section>

        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <script>
        function handleGoogleSignIn(response) {
            fetch('/auth/google/token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ credential: response.credential }),
                credentials: 'same-origin'
            })
            .then(function(r) {
                if (r.ok) return r.json();
                throw new Error('Sign in failed');
            })
            .then(function(data) {
                window.location.href = data.redirect || '/account';
            })
            .catch(function(err) {
                var el = document.getElementById('signin-error');
                el.textContent = 'Sign in failed. Please try again.';
                el.style.display = 'block';
            });
        }
        </script>
    #endexport
#endextend
