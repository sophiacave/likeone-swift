#extend("layout"):
    #export("content"):
        <section class="site-section" style="min-height: 60vh; display: flex; align-items: center;">
            <div class="site-container" style="max-width: 420px; text-align: center;">
                <h1 class="site-section-title" style="margin-bottom: 8px;">Sign In</h1>
                <p style="color: var(--text-secondary); margin-bottom: 40px;">Access your courses, track progress, and earn certificates.</p>

                <!-- Google Sign In (custom button triggering GSI) -->
                <div id="g_id_onload"
                     data-client_id="469463762089-i84flm8nn1spmk79qf5kp67pp8u0idlq.apps.googleusercontent.com"
                     data-callback="handleGoogleSignIn"
                     data-auto_prompt="false"
                     style="display:none;">
                </div>

                <button class="signin-btn signin-google" onclick="triggerGoogleSignIn()" aria-label="Sign in with Google">
                    <svg width="20" height="20" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    Sign in with Google
                </button>

                <a href="/auth/apple" class="signin-btn signin-apple" aria-label="Sign in with Apple">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                    Sign in with Apple
                </a>

                <div class="signin-divider"><span>or</span></div>

                <!-- Email Magic Link -->
                <form id="email-form" class="signin-email-form" onsubmit="handleEmailSignIn(event)" style="width:100%;text-align:left;">
                    <input type="email" id="email-input" class="signin-email-input" placeholder="your@email.com" required autocomplete="email" style="width:100%;display:block;padding:14px 18px;font-size:1rem;border-radius:12px;border:1px solid #27272a;background:#1a1a24;color:#f5f5f7;box-sizing:border-box;min-height:56px;font-family:inherit;" />
                    <button type="submit" class="signin-btn signin-email" style="margin-top:4px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Send Magic Link
                    </button>
                </form>
                <div id="email-status" class="signin-email-status" style="display:none;"></div>

                <div id="signin-error" class="signin-error" style="display:none;"></div>

                <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 32px;">No password required. Sign in with Google, Apple, or a magic link sent to your email.</p>
            </div>
        </section>

        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <script>
        function triggerGoogleSignIn() {
            if (window.google && google.accounts && google.accounts.id) {
                google.accounts.id.prompt();
            } else {
                document.getElementById('signin-error').textContent = 'Google Sign In is loading. Try again in a moment.';
                document.getElementById('signin-error').style.display = 'block';
            }
        }

        function handleGoogleSignIn(response) {
            fetch('/auth/google/token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ credential: response.credential }),
                credentials: 'same-origin'
            })
            .then(function(r) {
                if (r.ok) return r.json();
                throw new Error('Sign in failed');
            })
            .then(function(data) {
                window.location.href = data.redirect || '/account';
            })
            .catch(function(err) {
                var el = document.getElementById('signin-error');
                el.textContent = 'Google sign in failed. Please try again.';
                el.style.display = 'block';
            });
        }

        function handleEmailSignIn(e) {
            e.preventDefault();
            var email = document.getElementById('email-input').value;
            var status = document.getElementById('email-status');
            var btn = e.target.querySelector('button');
            btn.disabled = true;
            btn.textContent = 'Sending...';

            fetch('/auth/magic-link', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email }),
                credentials: 'same-origin'
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                status.textContent = 'Check your email! We sent a sign-in link to ' + email;
                status.className = 'signin-email-status signin-email-sent';
                status.style.display = 'block';
                btn.textContent = 'Link Sent';
            })
            .catch(function(err) {
                status.textContent = 'Failed to send link. Please try again.';
                status.className = 'signin-email-status signin-error';
                status.style.display = 'block';
                btn.disabled = false;
                btn.textContent = 'Send Magic Link';
            });
        }
        </script>
    #endexport
#endextend
