#extend("layout"):
    #export("content"):
        <!-- HERO -->
        <section class="site-hero">
            <div class="site-hero-inner">
                <h1 class="site-hero-title">Learn AI.<br><span class="accent-gradient">Build anything.</span></h1>
                <p class="site-hero-desc">52 courses. 520+ hands-on lessons. Preview every course free &mdash; upgrade to Pro for full access and certificates.</p>
                <div class="site-cta-row">
                    <a class="site-btn-primary" href="/academy/ai-foundations/what-is-a-neuron">Start Lesson 1</a>
                    <a class="site-btn-secondary" href="/academy">Browse Courses</a>
                </div>
            </div>
        </section>

        <!-- STATS -->
        <section id="stats" class="site-stats-bar">
            <div class="site-stats-grid">
                #for(stat in stats):
                    <div>
                        <div class="site-stat-number">#(stat.number)</div>
                        <div class="site-stat-label">#(stat.label)</div>
                    </div>
                #endfor
            </div>
        </section>

        <!-- FEATURED COURSES -->
        <section class="site-section">
            <div class="site-container text-center">
                <span class="site-section-tag">START HERE</span>
                <h2 class="site-section-title">Pick a course. Start learning.</h2>
                <p class="site-section-desc">First 3 lessons free on every course. Hands-on quizzes, flashcards, and visual aids.</p>
                <div class="site-card-grid">
                    #for(course in featured):
                        <a href="/academy/#(course.slug)" class="site-card" style="text-decoration:none;color:inherit;">
                            <div class="site-card-emoji">#(course.emoji)</div>
                            <div class="site-card-title">#(course.title)</div>
                            <div class="site-card-desc">#(course.description)</div>
                            <div style="margin-top:12px;padding-top:10px;border-top:1px solid var(--border);">
                                <span style="font-size:.7rem;color:var(--purple-400);text-transform:uppercase;letter-spacing:.05em;font-weight:600;">#(course.tier)</span>
                            </div>
                        </a>
                    #endfor
                </div>
                <div style="margin-top:32px;">
                    <a class="site-btn-secondary" href="/academy">All 52 Courses &rarr;</a>
                </div>
            </div>
        </section>

        <!-- LEARNING PATH -->
        <section class="site-section-alt">
            <div class="site-container text-center">
                <span class="site-section-tag">YOUR JOURNEY</span>
                <h2 class="site-section-title">Three tiers. One path.</h2>
                <p class="site-section-desc">Start wherever you are. Every tier builds on the last.</p>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px;max-width:900px;margin-left:auto;margin-right:auto;">
                    #for(tier in tiers):
                        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px 24px;text-align:center;transition:transform .3s,border-color .3s;">
                            <div style="font-size:2.5rem;margin-bottom:12px;">#(tier.emoji)</div>
                            <div style="font-size:1.1rem;font-weight:600;color:var(--text-primary);margin-bottom:4px;">#(tier.name)</div>
                            <div style="font-size:2rem;font-weight:800;color:var(--purple-400);margin-bottom:8px;">#(tier.count)</div>
                            <div style="font-size:.75rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px;">COURSES</div>
                            <div style="font-size:.9rem;color:var(--text-secondary);line-height:1.5;">#(tier.description)</div>
                        </div>
                    #endfor
                </div>
            </div>
        </section>

        <!-- HOW IT WORKS -->
        <section class="site-section">
            <div class="site-container text-center">
                <span class="site-section-tag">HOW IT WORKS</span>
                <h2 class="site-section-title">Read. Practice. Prove it.</h2>
                <p class="site-section-desc">Every lesson follows the same pattern. No filler. No fluff.</p>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px;max-width:900px;margin-left:auto;margin-right:auto;">
                    <div style="text-align:center;padding:24px;">
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(52,211,153,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:1.4rem;">1</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:8px;">Learn the concept</div>
                        <div style="font-size:.875rem;color:var(--text-secondary);line-height:1.55;">Visual diagrams, real code examples, and plain-language explanations. No jargon without context.</div>
                    </div>
                    <div style="text-align:center;padding:24px;">
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(168,85,247,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:1.4rem;">2</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:8px;">Study with flashcards</div>
                        <div style="font-size:.875rem;color:var(--text-secondary);line-height:1.55;">Flip through key vocabulary. Study mode or browse mode. Lock in the terminology before the quiz.</div>
                    </div>
                    <div style="text-align:center;padding:24px;">
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(251,146,60,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:1.4rem;">3</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:8px;">Prove it with quizzes</div>
                        <div style="font-size:.875rem;color:var(--text-secondary);line-height:1.55;">One question at a time. Visual aids. Instant feedback. Retry until you get 100%. No guessing.</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- LATEST FROM THE BLOG -->
        <section class="site-section-alt">
            <div class="site-container">
                <div class="text-center">
                    <span class="site-section-tag">FROM THE BLOG</span>
                    <h2 class="site-section-title">Built in public. Written with love.</h2>
                    <p class="site-section-desc">Real stories about building AI infrastructure, shipping products, and learning in the open.</p>
                </div>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px;">
                    #for(post in latestPosts):
                        <a href="/blog/#(post.slug)" style="display:block;padding:24px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);text-decoration:none;color:inherit;transition:transform .3s,border-color .3s;">
                            <div style="font-size:.8rem;color:var(--text-muted);margin-bottom:8px;">#(post.date)</div>
                            <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:8px;line-height:1.3;">#(post.title)</div>
                            <div style="font-size:.875rem;color:var(--text-secondary);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">#(post.description)</div>
                        </a>
                    #endfor
                </div>
                <div style="text-align:center;margin-top:24px;">
                    <a class="site-btn-secondary" href="/blog">All Posts &rarr;</a>
                </div>
            </div>
        </section>

        <!-- FINAL CTA -->
        <section class="site-section" style="padding-bottom:120px;">
            <div class="site-container text-center">
                <h2 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;letter-spacing:-.02em;margin-bottom:16px;color:var(--text-primary);">Your first lesson takes 5 minutes.</h2>
                <p style="font-size:1.1rem;color:var(--text-secondary);max-width:480px;margin:0 auto 32px;line-height:1.6;">No account required to start. Preview any course free and see if AI clicks for you.</p>
                <a class="site-btn-primary" href="/academy/ai-foundations/what-is-a-neuron" style="font-size:1rem;padding:14px 36px;">Start Learning &rarr;</a>
            </div>
        </section>
    #endexport
#endextend
