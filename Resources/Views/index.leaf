#extend("layout"):
    #export("content"):
        <!-- HERO -->
        <section class="site-hero">
            <div class="site-hero-inner">
                <h1 class="site-hero-title">Learn AI.<br><span class="accent-gradient">Build anything.</span></h1>
                <p class="site-hero-desc">53 courses, 542+ lessons. Preview every course free &mdash; upgrade to Pro for full access and certificates.</p>
                <div class="site-cta-row">
                    <a class="site-btn-primary" href="/academy/ai-foundations/what-is-a-neuron">Start Lesson 1</a>
                    <a class="site-btn-secondary" href="/academy">Browse Courses</a>
                </div>
            </div>
        </section>

        <!-- STATS -->
        <section id="stats" class="site-stats-bar">
            <div class="site-stats-grid">
                #for(stat in stats):
                    <div>
                        <div class="site-stat-number">#(stat.number)</div>
                        <div class="site-stat-label">#(stat.label)</div>
                    </div>
                #endfor
            </div>
        </section>

        <!-- FEATURED COURSES -->
        <section class="site-section">
            <div class="site-container text-center">
                <span class="site-section-tag">START HERE</span>
                <h2 class="site-section-title">Pick a course. Start learning.</h2>
                <p class="site-section-desc">First 3 lessons free on every course. Hands-on quizzes, flashcards, and visual aids.</p>
                <div class="site-card-grid">
                    #for(course in featured):
                        <a href="/academy/#(course.slug)" class="site-card" style="text-decoration:none;color:inherit;">
                            <div class="site-card-emoji">#(course.emoji)</div>
                            <div class="site-card-title">#(course.title)</div>
                            <div class="site-card-desc">#(course.description)</div>
                            <div class="site-card-tier-wrap">
                                <span class="site-card-tier">#(course.tier)</span>
                            </div>
                        </a>
                    #endfor
                </div>
                <div class="homepage-cta-wrap">
                    <a class="site-btn-secondary" href="/academy">All 52 Courses &rarr;</a>
                </div>
            </div>
        </section>

        <!-- LEARNING PATH -->
        <section class="site-section-alt">
            <div class="site-container text-center">
                <span class="site-section-tag">YOUR JOURNEY</span>
                <h2 class="site-section-title">Three tiers. One path.</h2>
                <p class="site-section-desc">Start wherever you are. Every tier builds on the last.</p>
                <div class="homepage-tier-grid">
                    #for(tier in tiers):
                        <div class="homepage-tier-card">
                            <div class="homepage-tier-emoji">#(tier.emoji)</div>
                            <div class="homepage-tier-name">#(tier.name)</div>
                            <div class="homepage-tier-count">#(tier.count)</div>
                            <div class="homepage-tier-label">COURSES</div>
                            <div class="homepage-tier-desc">#(tier.description)</div>
                        </div>
                    #endfor
                </div>
            </div>
        </section>

        <!-- HOW IT WORKS -->
        <section class="site-section">
            <div class="site-container text-center">
                <span class="site-section-tag">HOW IT WORKS</span>
                <h2 class="site-section-title">Read. Practice. Prove it.</h2>
                <p class="site-section-desc">Every lesson follows the same pattern. No filler. No fluff.</p>
                <div class="homepage-steps-grid">
                    <div class="homepage-step">
                        <div class="homepage-step-icon homepage-step-icon--learn">1</div>
                        <div class="homepage-step-title">Learn the concept</div>
                        <div class="homepage-step-desc">Visual diagrams, real code examples, and plain-language explanations. No jargon without context.</div>
                    </div>
                    <div class="homepage-step">
                        <div class="homepage-step-icon homepage-step-icon--study">2</div>
                        <div class="homepage-step-title">Study with flashcards</div>
                        <div class="homepage-step-desc">Flip through key vocabulary. Study mode or browse mode. Lock in the terminology before the quiz.</div>
                    </div>
                    <div class="homepage-step">
                        <div class="homepage-step-icon homepage-step-icon--prove">3</div>
                        <div class="homepage-step-title">Prove it with quizzes</div>
                        <div class="homepage-step-desc">One question at a time. Visual aids. Instant feedback. Retry until you get 100%. No guessing.</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- LATEST FROM THE BLOG -->
        <section class="site-section-alt">
            <div class="site-container">
                <div class="text-center">
                    <span class="site-section-tag">FROM THE BLOG</span>
                    <h2 class="site-section-title">Built in public. Written with love.</h2>
                    <p class="site-section-desc">Real stories about building AI infrastructure, shipping products, and learning in the open.</p>
                </div>
                <div class="homepage-blog-grid">
                    #for(post in latestPosts):
                        <a href="/blog/#(post.slug)/" class="homepage-blog-card">
                            <div class="homepage-blog-date">#(post.date)</div>
                            <div class="homepage-blog-title">#(post.title)</div>
                            <div class="homepage-blog-desc">#(post.description)</div>
                        </a>
                    #endfor
                </div>
                <div class="homepage-cta-wrap">
                    <a class="site-btn-secondary" href="/blog">All Posts &rarr;</a>
                </div>
            </div>
        </section>

        <!-- FINAL CTA -->
        <section class="site-section" style="padding-bottom:120px;">
            <div class="site-container text-center">
                <h2 class="homepage-final-title">Your first lesson takes 5 minutes.</h2>
                <p class="homepage-final-desc">No account required to start. Preview any course free and see if AI clicks for you.</p>
                <a class="site-btn-primary" href="/academy/ai-foundations/what-is-a-neuron">Start Learning &rarr;</a>
            </div>
        </section>
    #endexport
#endextend
