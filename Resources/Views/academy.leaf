#extend("layout"):
    #export("content"):
        <section class="academy-hero">
            <div class="site-container">
                <span class="academy-tag">AI ACADEMY</span>
                <h1 class="academy-title">Learn by<br><span class="accent-gradient">building</span></h1>
                <p class="academy-subtitle">#(description)</p>
                <div class="academy-stats">
                    <div class="academy-stat">
                        <span class="academy-stat-num">#(totalCourses)</span>
                        <span class="academy-stat-label">Courses</span>
                    </div>
                    <div class="academy-stat">
                        <span class="academy-stat-num">#(totalLessons)+</span>
                        <span class="academy-stat-label">Lessons</span>
                    </div>
                    <div class="academy-stat">
                        <span class="academy-stat-num">$0</span>
                        <span class="academy-stat-label">To Start</span>
                    </div>
                    <div class="academy-stat">
                        <span class="academy-stat-num">3</span>
                        <span class="academy-stat-label">Levels</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="academy-filters" aria-label="Course filters">
            <div class="site-container">
                <div class="academy-filter-row">
                    <button class="academy-filter-btn #if(activeTier == "all"):active#endif"
                            hx-get="/academy/filter?tier=all"
                            hx-target="#course-grid"
                            hx-swap="innerHTML"
                            aria-pressed="#if(activeTier == "all"):true#else:false#endif">
                        All
                    </button>
                    #for(tier in tiers):
                        <button class="academy-filter-btn #if(activeTier == tier.name):active#endif"
                                hx-get="/academy/filter?tier=#lowercased(tier.name)"
                                hx-target="#course-grid"
                                hx-swap="innerHTML"
                                aria-pressed="#if(activeTier == tier.name):true#else:false#endif">
                            #(tier.emoji) #(tier.name) <span class="filter-count">#(tier.count)</span>
                        </button>
                    #endfor
                </div>
            </div>
        </section>

        <section class="academy-courses" aria-label="Course catalog">
            <div class="site-container">
                <div class="academy-grid" id="course-grid">
                    #for(course in courses):
                        <a href="/academy/#(course.slug)" class="course-card" aria-label="#(course.title) — #(course.lessonCount) lessons">
                            <div class="course-card-emoji">#(course.emoji)</div>
                            <span class="course-card-level">#(course.level)</span>
                            <h3 class="course-card-title">#(course.title)</h3>
                            <p class="course-card-desc">#(course.description)</p>
                            <div class="course-card-meta">
                                <span class="course-card-lessons">#(course.lessonCount) lessons</span>
                                <span class="course-card-tier">#(course.tier)</span>
                            </div>
                        </a>
                    #endfor
                </div>
            </div>
        </section>
    #endexport
#endextend
