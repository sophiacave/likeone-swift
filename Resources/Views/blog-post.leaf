#extend("layout"):
    #export("content"):
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Article",
            "headline": "#(post.title)",
            "description": "#(description)",
            "author": {"@type": "Person", "name": "#(post.author)"},
            "publisher": {"@type": "Organization", "name": "Like One", "url": "https://likeone.ai"},
            "datePublished": "#(isoDate)",
            "dateModified": "#(isoDate)",
            "url": "#(canonicalUrl)",
            "mainEntityOfPage": {"@type": "WebPage", "@id": "#(canonicalUrl)"}
            #if(ogImage):,"image": "#(ogImage)"#endif
        }
        </script>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://likeone.ai/"},
                {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://likeone.ai/blog/"},
                {"@type": "ListItem", "position": 3, "name": "#(post.title)"}
            ]
        }
        </script>
        #if(faqs):
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
                #for(faq in faqs):
                {
                    "@type": "Question",
                    "name": "#(faq.question)",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "#(faq.answer)"
                    }
                }#if(!isLast):,#endif
                #endfor
            ]
        }
        </script>
        #endif
        <article class="blog-article">
            <div class="reading-column">
                <a href="/blog" class="course-back">&larr; Back to Blog</a>

                <div class="blog-article-meta">
                    <span class="blog-card-date">#(post.date)</span>
                    <span class="blog-card-author">#(post.author)</span>
                </div>

                <h1 class="blog-article-title">#(post.title)</h1>
                <p class="blog-article-lede">#(post.description)</p>

                <div class="blog-card-tags blog-article-tags">
                    #for(tag in post.tags):
                        <span class="blog-tag">#(tag)</span>
                    #endfor
                </div>

                <hr class="article-divider">

                <div class="article-content">
                    #unsafeHTML(content)
                </div>

                <hr class="article-divider">

                <div class="blog-cta">
                    <p class="blog-cta-heading">Keep learning — for free</p>
                    <p class="blog-cta-text">52 AI courses. 520+ lessons. No paywall for starters.</p>
                    <div class="site-cta-row">
                        <a href="/academy/" class="site-btn-primary">Browse courses</a>
                        <a href="/pricing/" class="site-btn-secondary">Go Pro — $4.90/mo</a>
                    </div>
                </div>

                <div class="blog-cta" style="margin-top:24px;border-color:#c084fc33;">
                    <p class="blog-cta-heading">Need help building this?</p>
                    <p class="blog-cta-text">We build MCP servers, Claude workflows, and AI agents for teams. Strategy calls start at $150/hr.</p>
                    <div class="site-cta-row">
                        <a href="/consulting/" class="site-btn-primary">Consulting</a>
                    </div>
                </div>

                #if(relatedPosts):
                <div class="related-section">
                    <h3 class="related-heading">Related Articles</h3>
                    <div class="related-grid">
                        #for(related in relatedPosts):
                        <a href="/blog/#(related.slug)/" class="related-card">
                            <div class="related-card-title">#(related.title)</div>
                            <div class="related-card-desc">#(related.description)</div>
                        </a>
                        #endfor
                    </div>
                </div>
                #endif

                <div class="blog-article-footer">
                    <a href="/blog" class="site-btn-secondary">All Articles</a>
                </div>
            </div>
        </article>
    #endexport
#endextend
