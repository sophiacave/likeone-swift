#extend("layout"):
    #export("content"):
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Article",
            "headline": "#(post.title)",
            "description": "#(description)",
            "author": {"@type": "Person", "name": "#(post.author)"},
            "publisher": {"@type": "Organization", "name": "Like One", "url": "https://likeone.ai"},
            "datePublished": "#(isoDate)",
            "url": "#(canonicalUrl)"
            #if(ogImage):,"image": "#(ogImage)"#endif
        }
        </script>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://likeone.ai/"},
                {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://likeone.ai/blog/"},
                {"@type": "ListItem", "position": 3, "name": "#(post.title)"}
            ]
        }
        </script>
        <article class="blog-article">
            <div class="reading-column">
                <a href="/blog" class="course-back">&larr; Back to Blog</a>

                <div class="blog-article-meta">
                    <span class="blog-card-date">#(post.date)</span>
                    <span class="blog-card-author">#(post.author)</span>
                </div>

                <h1 class="blog-article-title">#(post.title)</h1>
                <p class="blog-article-lede">#(post.description)</p>

                <div class="blog-card-tags blog-article-tags">
                    #for(tag in post.tags):
                        <span class="blog-tag">#(tag)</span>
                    #endfor
                </div>

                <hr class="article-divider">

                <div class="article-content">
                    #unsafeHTML(content)
                </div>

                <hr class="article-divider">

                #if(relatedPosts):
                <div class="related-section">
                    <h3 class="related-heading">Related Articles</h3>
                    <div class="related-grid">
                        #for(related in relatedPosts):
                        <a href="/blog/#(related.slug)/" class="related-card">
                            <div class="related-card-title">#(related.title)</div>
                            <div class="related-card-desc">#(related.description)</div>
                        </a>
                        #endfor
                    </div>
                </div>
                #endif

                <div class="blog-article-footer">
                    <a href="/blog" class="site-btn-secondary">All Articles</a>
                </div>
            </div>
        </article>
    #endexport
#endextend
