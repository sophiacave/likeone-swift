#extend("layout"):
    #export("content"):
        <article class="site-section" style="padding-top: 48px;">
            <div class="site-container" style="max-width: 720px;">
                <a href="/blog" class="course-back">&larr; Back to Blog</a>
                <div class="blog-card-meta" style="margin-bottom: 12px;">
                    <span class="blog-card-date">#(post.date)</span>
                    <span class="blog-card-author">#(post.author)</span>
                </div>
                <h1 class="course-hero-title" style="text-align: left; margin-bottom: 16px;">#(post.title)</h1>
                <p class="course-hero-desc" style="text-align: left; margin: 0 0 12px;">#(post.description)</p>
                <div class="blog-card-tags" style="margin-bottom: 40px;">
                    #for(tag in post.tags):
                        <span class="blog-tag">#(tag)</span>
                    #endfor
                </div>
                <div class="blog-content">
                    #unsafeHTML(content)
                </div>
            </div>
        </article>
    #endexport
#endextend
