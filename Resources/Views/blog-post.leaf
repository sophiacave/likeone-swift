#extend("layout"):
    #export("content"):
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Article",
            "headline": "#(post.title)",
            "description": "#(description)",
            "author": {"@type": "Person", "name": "#(post.author)"},
            "publisher": {"@type": "Organization", "name": "Like One", "url": "https://likeone.ai"},
            "datePublished": "#(isoDate)",
            "url": "#(canonicalUrl)"
            #if(ogImage):,"image": "#(ogImage)"#endif
        }
        </script>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://likeone.ai/"},
                {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://likeone.ai/blog/"},
                {"@type": "ListItem", "position": 3, "name": "#(post.title)"}
            ]
        }
        </script>
        <article class="blog-article">
            <div class="reading-column">
                <a href="/blog" class="course-back">&larr; Back to Blog</a>

                <div class="blog-article-meta">
                    <span class="blog-card-date">#(post.date)</span>
                    <span class="blog-card-author">#(post.author)</span>
                </div>

                <h1 class="blog-article-title">#(post.title)</h1>
                <p class="blog-article-lede">#(post.description)</p>

                <div class="blog-card-tags" style="margin-bottom: 32px;">
                    #for(tag in post.tags):
                        <span class="blog-tag">#(tag)</span>
                    #endfor
                </div>

                <hr class="article-divider">

                <div class="article-content">
                    #unsafeHTML(content)
                </div>

                <hr class="article-divider">

                #if(relatedPosts):
                <div style="padding: 40px 0;">
                    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 24px; color: var(--text-primary);">Related Articles</h3>
                    <div style="display: grid; gap: 20px;">
                        #for(related in relatedPosts):
                        <a href="/blog/#(related.slug)/" style="display: block; padding: 20px; border-radius: 12px; background: var(--surface-secondary); text-decoration: none; transition: background 0.2s;">
                            <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 6px;">#(related.title)</div>
                            <div style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5;">#(related.description)</div>
                        </a>
                        #endfor
                    </div>
                </div>
                #endif

                <div style="text-align: center; padding: 20px 0 40px;">
                    <a href="/blog" class="site-btn-secondary">All Articles</a>
                </div>
            </div>
        </article>
    #endexport
#endextend
