#extend("layout"):
    #export("content"):
        <section class="course-hero">
            <div class="site-container" style="max-width: 800px;">
                <a href="/academy" class="course-back">&larr; Back to Academy</a>
                <div class="course-hero-emoji">#(course.emoji)</div>
                <span class="course-card-level" style="margin-bottom: 0.5rem; display: inline-block;">#(course.level)</span>
                <h1 class="course-hero-title">#(course.title)</h1>
                <p class="course-hero-desc">#(course.description)</p>
                <div class="course-hero-meta">
                    <span>#(course.lessonCount) lessons</span>
                    <span>&bull;</span>
                    <span style="text-transform: capitalize;">#(course.tier)</span>
                </div>
            </div>
        </section>

        <section class="site-section">
            <div class="site-container" style="max-width: 800px;">
                <h2 class="site-section-title" style="margin-bottom: 24px;">Lessons</h2>
                <div class="lesson-list">
                    #for(lesson in lessons):
                        <div class="lesson-row">
                            <div class="lesson-row-left">
                                <span class="lesson-num">#(lesson.order)</span>
                                <span class="lesson-title">#(lesson.title)</span>
                            </div>
                            <span class="lesson-badge #if(lesson.isFree):lesson-free#else:lesson-pro#endif">
                                #if(lesson.isFree):Free#else:Pro#endif
                            </span>
                        </div>
                    #endfor
                </div>
                <div style="margin-top: 32px; text-align: center;">
                    <a href="/academy" class="site-btn-secondary">Browse All Courses</a>
                </div>
            </div>
        </section>
    #endexport
#endextend
