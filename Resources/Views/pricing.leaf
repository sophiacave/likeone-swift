#extend("layout"):
    #export("content"):
        <section class="page-hero">
            <div class="site-container text-center">
                <span class="site-section-tag">PRICING</span>
                <h1 class="page-hero-title">Learn free.<br><span class="accent-gradient">Prove it with Pro.</span></h1>
                <p class="page-hero-desc">Every course and lesson is free forever. Pro adds verified certificates, PDF downloads, and LinkedIn credentials.</p>
            </div>
        </section>

        <section class="site-section">
            <div class="site-container" style="max-width:1000px;">
                <div class="pricing-grid">
                    <div class="pricing-card pricing-card-free">
                        <div class="pricing-badge">FREE FOREVER</div>
                        <h2 class="pricing-plan-name">Academy</h2>
                        <div class="pricing-price">$0</div>
                        <div class="pricing-period">forever</div>
                        <ul class="pricing-features">
                            <li>52 courses across 7 levels</li>
                            <li>521 hands-on lessons</li>
                            <li>Interactive quizzes &amp; visual aids</li>
                            <li>Flashcard study mode</li>
                            <li>Progress tracking</li>
                            <li>Full-text search</li>
                            <li>No account required</li>
                        </ul>
                        <a class="site-btn-primary" href="/academy" style="width:100%;text-align:center;">Start Learning</a>
                    </div>

                    <div class="pricing-card pricing-card-pro">
                        <div class="pricing-badge pricing-badge-pro">MOST POPULAR</div>
                        <h2 class="pricing-plan-name">Academy Pro</h2>
                        <div class="pricing-price">$19</div>
                        <div class="pricing-period">per month</div>
                        <ul class="pricing-features">
                            <li>Everything in Academy</li>
                            <li>Verified completion certificates</li>
                            <li>PDF certificate downloads</li>
                            <li>LinkedIn-ready credentials</li>
                            <li>Learning track certificates</li>
                            <li>Priority support</li>
                            <li>Cancel anytime</li>
                        </ul>
                        <form method="POST" action="/checkout">
                            <input type="hidden" name="plan" value="academy-pro-monthly">
                            <button type="submit" class="site-btn-primary" style="width:100%;border:none;cursor:pointer;">Subscribe Monthly</button>
                        </form>
                    </div>

                    <div class="pricing-card pricing-card-annual">
                        <div class="pricing-badge pricing-badge-save">SAVE 35%</div>
                        <h2 class="pricing-plan-name">Academy Pro</h2>
                        <div class="pricing-price">$149</div>
                        <div class="pricing-period">per year</div>
                        <ul class="pricing-features">
                            <li>Everything in Pro</li>
                            <li>Save $79 vs monthly</li>
                            <li>Founding member badge</li>
                            <li>Early access to new courses</li>
                            <li>Direct support from founder</li>
                            <li>All future features included</li>
                            <li>Lock in this price forever</li>
                        </ul>
                        <form method="POST" action="/checkout">
                            <input type="hidden" name="plan" value="academy-pro-annual">
                            <button type="submit" class="site-btn-primary" style="width:100%;border:none;cursor:pointer;">Subscribe Annually</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <section class="site-section-alt">
            <div class="site-container" style="max-width:700px;">
                <h2 class="site-section-title text-center">Why is it free?</h2>
                <div class="pricing-faq">
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">How can you afford to give this away?</h3>
                        <p class="pricing-faq-a">Like One is a 501(c)(3) nonprofit. Our mission is education access, not profit extraction. We keep costs near zero with efficient infrastructure and a small team.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">Will the free courses ever go behind a paywall?</h3>
                        <p class="pricing-faq-a">No. The Academy will always be free. Pro subscriptions fund the free education and unlock certificates as proof of your learning.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">Where does the money go?</h3>
                        <p class="pricing-faq-a">Revenue from Pro subscriptions funds three things: keeping the Academy free, building accessibility tools for disabled communities, and donating to HIV cure research at UCSF.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">Can I try Pro before subscribing?</h3>
                        <p class="pricing-faq-a">You can take every course for free right now. Pro adds verified certificates when you complete courses. If you learn here, we think you'll want the proof.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="site-section">
            <div class="site-container text-center" style="padding-bottom:80px;">
                <h2 style="font-size:clamp(1.5rem,3.5vw,2.25rem);font-weight:700;letter-spacing:-.02em;margin-bottom:16px;color:var(--text-primary);">Ready?</h2>
                <p style="font-size:1rem;color:var(--text-secondary);max-width:400px;margin:0 auto 28px;line-height:1.6;">Pick a course and start. Five minutes from now, you'll know something new.</p>
                <a class="site-btn-primary" href="/academy">Browse All 52 Courses</a>
            </div>
        </section>
    #endexport
#endextend
