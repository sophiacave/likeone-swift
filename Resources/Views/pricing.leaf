#extend("layout"):
    #export("content"):
        <section class="page-hero">
            <div class="site-container text-center">
                <span class="site-section-tag">PRICING</span>
                <h1 class="page-hero-title">Learn free.<br><span class="accent-gradient">Prove it with Pro.</span></h1>
                <p class="page-hero-desc">Preview every course with 3 free lessons. Pro unlocks all 520+ lessons, verified certificates, and LinkedIn credentials.</p>
            </div>
        </section>

        <section class="site-section">
            <div class="site-container" style="max-width:1000px;">
                <div class="pricing-grid">
                    <div class="pricing-card pricing-card-free">
                        <div class="pricing-badge">FREE FOREVER</div>
                        <h2 class="pricing-plan-name">Academy</h2>
                        <div class="pricing-price">$0</div>
                        <div class="pricing-period">forever</div>
                        <ul class="pricing-features">
                            <li>52 courses, beginner to advanced</li>
                            <li>First 3 lessons per course</li>
                            <li>Interactive quizzes &amp; visual aids</li>
                            <li>Flashcard study mode</li>
                            <li>Progress tracking</li>
                            <li>Full-text search</li>
                            <li>No account required</li>
                        </ul>
                        <a class="site-btn-primary" href="/academy" style="width:100%;text-align:center;">Start Learning Free</a>
                    </div>

                    <div class="pricing-card pricing-card-pro">
                        <div class="pricing-badge pricing-badge-pro">MOST POPULAR</div>
                        <h2 class="pricing-plan-name">Academy Pro</h2>
                        <div class="pricing-price">$19</div>
                        <div class="pricing-period">per month</div>
                        <ul class="pricing-features">
                            <li>Full access to all 520+ lessons</li>
                            <li>52 complete courses, beginner to advanced</li>
                            <li>Verified certificates on completion</li>
                            <li>PDF downloads &amp; LinkedIn sharing</li>
                            <li>Learning track certifications</li>
                            <li>Fund free education &amp; HIV research</li>
                            <li>Cancel anytime</li>
                        </ul>
                        <form method="POST" action="/checkout">
                            <input type="hidden" name="plan" value="academy-pro-monthly">
                            <button type="submit" class="site-btn-primary" style="width:100%;border:none;cursor:pointer;">Get Pro &mdash; $19/mo</button>
                        </form>
                    </div>

                    <div class="pricing-card pricing-card-annual">
                        <div class="pricing-badge pricing-badge-save">SAVE 35%</div>
                        <h2 class="pricing-plan-name">Academy Pro</h2>
                        <div class="pricing-price">$149</div>
                        <div class="pricing-period">per year <span style="color:var(--green,#34d399);font-weight:600;">($12.42/mo)</span></div>
                        <ul class="pricing-features">
                            <li>Everything in Pro</li>
                            <li>Save $79 vs monthly</li>
                            <li>Founding member badge</li>
                            <li>All future features included</li>
                            <li>Lock in this price forever</li>
                            <li>Support free education</li>
                            <li>Fund HIV cure research</li>
                        </ul>
                        <form method="POST" action="/checkout">
                            <input type="hidden" name="plan" value="academy-pro-annual">
                            <button type="submit" class="site-btn-primary" style="width:100%;border:none;cursor:pointer;">Go Annual &mdash; Save 35%</button>
                        </form>
                    </div>
                </div>

                <!-- Trust signals -->
                <div style="display:flex;justify-content:center;gap:32px;margin-top:32px;flex-wrap:wrap;">
                    <div style="display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--text-muted);">
                        <span style="color:var(--green,#34d399);">&#x2714;</span> Secure checkout via Stripe
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--text-muted);">
                        <span style="color:var(--green,#34d399);">&#x2714;</span> Cancel anytime, no questions
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--text-muted);">
                        <span style="color:var(--green,#34d399);">&#x2714;</span> 1% funds HIV cure research
                    </div>
                </div>
            </div>
        </section>

        <!-- What Pro unlocks -->
        <section class="site-section-alt">
            <div class="site-container" style="max-width:800px;">
                <h2 class="site-section-title text-center">What Pro unlocks</h2>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px;">
                    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px;text-align:center;">
                        <div style="font-size:2rem;margin-bottom:8px;">&#x1F513;</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:6px;">Full Access</div>
                        <div style="font-size:.85rem;color:var(--text-secondary);line-height:1.5;">All 520+ lessons across 52 courses. Learn at your pace from beginner to advanced.</div>
                    </div>
                    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px;text-align:center;">
                        <div style="font-size:2rem;margin-bottom:8px;">&#x1F4DC;</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:6px;">Verified Certificates</div>
                        <div style="font-size:.85rem;color:var(--text-secondary);line-height:1.5;">Earn credentials on completion. Download PDFs, share on LinkedIn, verify online.</div>
                    </div>
                    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px;text-align:center;">
                        <div style="font-size:2rem;margin-bottom:8px;">&#x1F49C;</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:6px;">Fund the Mission</div>
                        <div style="font-size:.85rem;color:var(--text-secondary);line-height:1.5;">Your subscription funds free AI education and HIV cure research at UCSF.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="site-section">
            <div class="site-container" style="max-width:700px;">
                <h2 class="site-section-title text-center">Questions</h2>
                <div class="pricing-faq">
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">Can I try before I pay?</h3>
                        <p class="pricing-faq-a">Yes. The first 3 lessons of every course are free &mdash; no account needed. Try any course, see if it clicks, then upgrade when you're ready.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">What if I cancel?</h3>
                        <p class="pricing-faq-a">Cancel in one click from your account page. You keep access until your billing period ends, and certificates you've earned are yours forever.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">Where does my subscription go?</h3>
                        <p class="pricing-faq-a">Three places: keeping the Academy running, building the courses, and funding HIV cure research at UCSF through the Like One Foundation. 1% of revenue goes directly to research.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">How is this different from free AI tutorials?</h3>
                        <p class="pricing-faq-a">Structure. Our 52 courses build on each other &mdash; from basics to autonomous agents. Every lesson has quizzes, flashcards, and visual aids. Pro adds verified certificates you can share on LinkedIn.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="site-section-alt">
            <div class="site-container text-center" style="padding:60px 20px;">
                <h2 style="font-size:clamp(1.5rem,3.5vw,2.25rem);font-weight:700;letter-spacing:-.02em;margin-bottom:12px;color:var(--text-primary);">Start now. Decide later.</h2>
                <p style="font-size:1rem;color:var(--text-secondary);max-width:440px;margin:0 auto 28px;line-height:1.6;">Preview any course with 3 free lessons. If you want full access and certificates, upgrade whenever you're ready.</p>
                <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                    <a class="site-btn-primary" href="/academy">Browse 52 Free Courses</a>
                </div>
            </div>
        </section>
    #endexport
#endextend
