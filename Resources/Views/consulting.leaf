#extend("layout"):
    #export("content"):
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "ProfessionalService",
            "name": "Like One AI Consulting",
            "description": "AI systems that run your operations autonomously. Custom agents, MCP servers, and full-stack AI applications.",
            "url": "https://likeone.ai/consulting/",
            "provider": {
                "@type": "Organization",
                "name": "Like One Foundation",
                "url": "https://likeone.ai"
            },
            "areaServed": "US",
            "hasOfferCatalog": {
                "@type": "OfferCatalog",
                "name": "AI Consulting Services",
                "itemListElement": [
                    {
                        "@type": "Offer",
                        "itemOffered": {
                            "@type": "Service",
                            "name": "Strategy Call",
                            "description": "One-time AI architecture assessment, Claude Code and MCP setup guidance, written action plan"
                        },
                        "price": "150",
                        "priceCurrency": "USD",
                        "unitCode": "HUR"
                    },
                    {
                        "@type": "Offer",
                        "itemOffered": {
                            "@type": "Service",
                            "name": "Starter Retainer",
                            "description": "Async access with 24-hour turnaround, monthly strategy calls, MCP server builds"
                        },
                        "price": "500",
                        "priceCurrency": "USD",
                        "unitCode": "MON"
                    },
                    {
                        "@type": "Offer",
                        "itemOffered": {
                            "@type": "Service",
                            "name": "Full Retainer",
                            "description": "4 hrs/week synchronous collaboration, unlimited async, custom AI agent development, 14-day deployment guarantee"
                        },
                        "price": "5000",
                        "priceCurrency": "USD",
                        "unitCode": "MON"
                    }
                ]
            }
        }
        </script>
        <section class="page-hero">
            <div class="site-container text-center">
                <span class="site-section-tag">CONSULTING</span>
                <h1 class="page-hero-title">AI that actually<br><span class="accent-gradient">works for you.</span></h1>
                <p class="page-hero-desc">We build AI systems that run your operations autonomously. Not slide decks. Not strategy sessions. Working systems.</p>
            </div>
        </section>

        <section class="site-section">
            <div class="site-container" style="max-width:1100px;">
                <div class="pricing-grid" style="grid-template-columns:1fr 1fr 1fr;">
                    <div class="pricing-card">
                        <div class="pricing-badge">ONE-TIME</div>
                        <h2 class="pricing-plan-name">Strategy Call</h2>
                        <div class="pricing-price">$150</div>
                        <div class="pricing-period">per hour</div>
                        <ul class="pricing-features">
                            <li>1:1 video or async session</li>
                            <li>AI architecture assessment</li>
                            <li>Claude Code / MCP setup guidance</li>
                            <li>Written action plan delivered</li>
                            <li>No commitment</li>
                        </ul>
                        <a href="mailto:hello@likeone.ai?subject=Consulting%20Strategy%20Call" class="site-btn-primary" style="display:block;text-align:center;text-decoration:none;">Book a Call</a>
                    </div>

                    <div class="pricing-card">
                        <div class="pricing-badge">ASYNC</div>
                        <h2 class="pricing-plan-name">Starter</h2>
                        <div class="pricing-price">$500</div>
                        <div class="pricing-period">per month</div>
                        <ul class="pricing-features">
                            <li>Async access to our AI stack</li>
                            <li>24-hour turnaround on requests</li>
                            <li>Monthly strategy call</li>
                            <li>MCP server builds + Claude setup</li>
                            <li>Academy Pro included (3 months)</li>
                            <li>Cancel anytime</li>
                        </ul>
                        <form method="POST" action="/checkout">
                            <input type="hidden" name="plan" value="consulting-starter">
                            <button type="submit" class="site-btn-primary" style="width:100%;border:none;cursor:pointer;">Get Started</button>
                        </form>
                    </div>

                    <div class="pricing-card pricing-card-pro">
                        <div class="pricing-badge pricing-badge-pro">FULL SERVICE</div>
                        <h2 class="pricing-plan-name">Retainer</h2>
                        <div class="pricing-price">$5,000</div>
                        <div class="pricing-period">per month</div>
                        <ul class="pricing-features">
                            <li>4 hrs/week synchronous collaboration</li>
                            <li>Unlimited async support</li>
                            <li>14-day time-to-first-deploy guarantee</li>
                            <li>Custom AI agent + MCP development</li>
                            <li>Full infrastructure architecture</li>
                            <li>Academy Pro included (lifetime)</li>
                        </ul>
                        <form method="POST" action="/checkout">
                            <input type="hidden" name="plan" value="consulting-retainer">
                            <button type="submit" class="site-btn-primary" style="width:100%;border:none;cursor:pointer;">Book Retainer</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <section class="site-section-alt">
            <div class="site-container" style="max-width:700px;">
                <h2 class="site-section-title text-center">What we build</h2>
                <div class="pricing-faq">
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">Autonomous AI agents</h3>
                        <p class="pricing-faq-a">Agents that handle operations without human intervention. Grant applications, content pipelines, customer support, revenue operations. Not chatbots. Systems that do real work.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">MCP server infrastructure</h3>
                        <p class="pricing-faq-a">Custom Model Context Protocol servers that connect AI to your existing tools. Databases, APIs, file systems, deployment pipelines. Secure by default.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">AI-native web applications</h3>
                        <p class="pricing-faq-a">Full-stack applications with AI built into the architecture, not bolted on. Swift, Next.js, or whatever your stack needs. From prototype to production.</p>
                    </div>
                    <div class="pricing-faq-item">
                        <h3 class="pricing-faq-q">Apple Intelligence integration</h3>
                        <p class="pricing-faq-a">Foundation Models, App Intents, and on-device AI for iOS and Mac apps. We run Apple's 3B model in production alongside Claude &mdash; the only team with proven hybrid Apple + Claude architecture. App Intents migration, Siri integration, custom adapter training.</p>
                    </div>
                </div>
            </div>
        </section>
    #endexport
#endextend
