#extend("layout"):
    #export("content"):
        <section class="site-section">
            <div class="site-container" style="max-width: 700px;">
                <h1 class="site-section-title">Your Account</h1>

                <!-- Profile Card -->
                <div class="account-card" style="margin-top: 2rem;">
                    <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">Signed in as</p>
                    <h2 style="color: var(--text-primary); margin-bottom: 0.25rem;">#(name)</h2>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">#(email)</p>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
                        <span class="account-badge">#(subscription)</span>
                    </div>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        #if(subscription == "pro" || subscription == "founding"):
                            <a href="/billing" class="site-btn-primary" style="display: inline-block;">Manage Billing</a>
                        #else:
                            <a href="/pricing" class="site-btn-primary" style="display: inline-block;">Upgrade to Pro</a>
                        #endif
                        <a href="/auth/logout" class="site-btn-secondary" style="display: inline-block;">Sign Out</a>
                    </div>
                </div>

                <!-- Certificates -->
                <div style="margin-top: 2.5rem;">
                    <h2 class="account-section-title">Certificates</h2>
                    <div id="account-certs" class="account-certs-list">
                        <div class="account-empty">Loading...</div>
                    </div>
                </div>

                <!-- Learning Progress -->
                <div style="margin-top: 2.5rem;">
                    <h2 class="account-section-title">Learning Progress</h2>
                    <div id="account-progress" class="account-progress-list">
                        <div class="account-empty">Loading...</div>
                    </div>
                </div>
            </div>
        </section>

        <script>
        // Load certificates
        fetch('/api/v1/progress/certificates', { credentials: 'same-origin' })
        .then(function(r) { return r.ok ? r.json() : []; })
        .then(function(certs) {
            var el = document.getElementById('account-certs');
            if (!certs.length) {
                el.innerHTML = '<div class="account-empty">No certificates yet. Complete a course or track to earn one!</div>';
                return;
            }
            el.innerHTML = certs.map(function(c) {
                var date = new Date(c.earnedAt || c.earned_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                return '<a href="/cert/' + c.id + '" class="account-cert-row">' +
                    '<div class="account-cert-info">' +
                        '<div class="account-cert-type">' + (c.type === 'track' ? 'Track' : 'Course') + '</div>' +
                        '<div class="account-cert-title">' + c.title + '</div>' +
                        '<div class="account-cert-date">' + date + '</div>' +
                    '</div>' +
                    '<div class="account-cert-view">View &rarr;</div>' +
                '</a>';
            }).join('');
        }).catch(function() {
            document.getElementById('account-certs').innerHTML = '<div class="account-empty">No certificates yet.</div>';
        });

        // Load progress with course details + continue links
        (function() {
            var progress = JSON.parse(localStorage.getItem('lo_progress') || '{}');
            var el = document.getElementById('account-progress');
            var slugs = Object.keys(progress).filter(function(k) { return progress[k].length > 0; });
            if (!slugs.length) {
                el.innerHTML = '<div class="account-empty">Start a course to track your progress! <a href="/academy" style="color:var(--purple-400);">Browse courses &rarr;</a></div>';
                return;
            }
            // Fetch course list for names and lesson counts
            fetch('/api/v1/courses', { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(courses) {
                var courseMap = {};
                courses.forEach(function(c) { courseMap[c.slug] = c; });

                // For each in-progress course, find next lesson
                var promises = slugs.map(function(slug) {
                    return fetch('/api/v1/courses/' + slug + '/lessons', { credentials: 'same-origin' })
                        .then(function(r) { return r.json(); })
                        .then(function(lessons) {
                            var done = progress[slug] || [];
                            var next = lessons.find(function(l) { return done.indexOf(l.slug) === -1; });
                            return { slug: slug, course: courseMap[slug], done: done.length, total: lessons.length, next: next };
                        });
                });

                Promise.all(promises).then(function(results) {
                    results.sort(function(a, b) { return b.done - a.done; });
                    el.innerHTML = results.map(function(r) {
                        var name = r.course ? r.course.title : r.slug.replace(/-/g, ' ');
                        var emoji = r.course ? r.course.emoji : '';
                        var pct = r.total > 0 ? Math.round((r.done / r.total) * 100) : 0;
                        var isComplete = r.done >= r.total && r.total > 0;
                        var continueUrl = r.next ? '/academy/' + r.slug + '/' + r.next.slug : '/academy/' + r.slug;
                        var btnText = isComplete ? 'Review' : 'Continue';

                        return '<div class="account-progress-card">' +
                            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">' +
                                '<a href="/academy/' + r.slug + '" style="font-weight:600;color:var(--text-primary);text-decoration:none;font-size:.95rem;">' + emoji + ' ' + name + '</a>' +
                                '<span style="font-size:.75rem;color:var(--text-muted);">' + r.done + ' / ' + r.total + '</span>' +
                            '</div>' +
                            '<div style="height:4px;background:rgba(255,255,255,.05);border-radius:2px;margin-bottom:10px;">' +
                                '<div style="height:100%;width:' + pct + '%;background:' + (isComplete ? 'var(--green,#34d399)' : 'var(--purple-400)') + ';border-radius:2px;transition:width .5s;"></div>' +
                            '</div>' +
                            '<a href="' + continueUrl + '" class="site-btn-primary" style="display:inline-block;font-size:.8rem;padding:6px 16px;text-decoration:none;">' + btnText + ' &rarr;</a>' +
                        '</div>';
                    }).join('');
                });
            }).catch(function() {
                el.innerHTML = slugs.map(function(slug) {
                    return '<div class="account-progress-row"><a href="/academy/' + slug + '">' + slug.replace(/-/g, ' ') + '</a></div>';
                }).join('');
            });
        })();
        </script>
    #endexport
#endextend
