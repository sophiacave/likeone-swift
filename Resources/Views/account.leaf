#extend("layout"):
    #export("content"):
        <section class="site-section">
            <div class="site-container" style="max-width: 700px;">
                <h1 class="site-section-title">Your Account</h1>

                <!-- Profile Card -->
                <div class="account-card" style="margin-top: 2rem;">
                    <div style="display:flex;align-items:center;gap:16px;margin-bottom:1.5rem;">
                        #if(avatarURL):
                            <img src="#(avatarURL)" alt="" style="width:48px;height:48px;border-radius:50%;object-fit:cover;">
                        #endif
                        <div>
                            <h2 style="color: var(--text-primary); margin: 0;">#(name)</h2>
                            <p style="color: var(--text-muted); margin: 0; font-size:.9rem;">#(email)</p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
                        <span class="account-badge">#(subscription)</span>
                    </div>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        #if(subscription == "pro" || subscription == "founding"):
                            <a href="/billing" class="site-btn-primary" style="display: inline-block;">Manage Billing</a>
                        #else:
                            <a href="/pricing" class="site-btn-primary" style="display: inline-block;">Upgrade to Pro</a>
                        #endif
                        <a href="/auth/logout" class="site-btn-secondary" style="display: inline-block;">Sign Out</a>
                    </div>
                </div>

                <!-- Stats -->
                #if(stats.lessonsCompleted > 0):
                <div style="margin-top:2rem;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
                    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;">
                        <div style="font-size:1.5rem;font-weight:700;color:var(--purple-400);">#(stats.lessonsCompleted)</div>
                        <div style="font-size:.75rem;color:var(--text-muted);margin-top:4px;">Lessons</div>
                    </div>
                    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;">
                        <div style="font-size:1.5rem;font-weight:700;color:var(--green,#34d399);">#(stats.coursesCompleted)</div>
                        <div style="font-size:.75rem;color:var(--text-muted);margin-top:4px;">Courses</div>
                    </div>
                    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;">
                        <div style="font-size:1.5rem;font-weight:700;color:gold;">#(stats.certificatesEarned)</div>
                        <div style="font-size:.75rem;color:var(--text-muted);margin-top:4px;">Certificates</div>
                    </div>
                </div>
                #endif

                <!-- Learning Progress (server-rendered) -->
                <div style="margin-top: 2.5rem;">
                    <h2 class="account-section-title">Learning Progress</h2>
                    #if(count(courses) > 0):
                        <div style="display:flex;flex-direction:column;gap:12px;margin-top:12px;">
                        #for(course in courses):
                            <div class="account-progress-card">
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                                    <a href="/academy/#(course.slug)/" style="font-weight:600;color:var(--text-primary);text-decoration:none;font-size:.95rem;">#(course.emoji) #(course.title)</a>
                                    <span style="font-size:.75rem;color:var(--text-muted);">#(course.completed) / #(course.total)</span>
                                </div>
                                <div style="height:4px;background:rgba(255,255,255,.05);border-radius:2px;margin-bottom:10px;">
                                    <div style="height:100%;width:#(course.percent)%;background:#if(course.isComplete):var(--green,#34d399)#else:var(--purple-400)#endif;border-radius:2px;transition:width .5s;"></div>
                                </div>
                                #if(course.nextLessonSlug):
                                    <a href="/academy/#(course.slug)/#(course.nextLessonSlug)/" class="site-btn-primary" style="font-size:.8rem;padding:6px 16px;min-height:auto;text-decoration:none;">Continue &rarr;</a>
                                #elseif(course.isComplete):
                                    <span style="font-size:.8rem;color:var(--green,#34d399);">Complete</span>
                                #endif
                            </div>
                        #endfor
                        </div>
                    #else:
                        <div class="account-empty">Start a course to track your progress! <a href="/academy" style="color:var(--purple-400);">Browse courses &rarr;</a></div>
                    #endif
                </div>

                <!-- Brain Suggestions -->
                #if(count(suggestions) > 0):
                <div style="margin-top: 2.5rem;">
                    <h2 class="account-section-title">Suggested for You</h2>
                    <p style="font-size:.8rem;color:var(--text-muted);margin-bottom:12px;">Based on your learning path</p>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">
                    #for(s in suggestions):
                        <a href="/academy/#(s.slug)/" style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:16px;text-decoration:none;color:inherit;transition:border-color .3s;">
                            <div style="font-size:1.5rem;margin-bottom:8px;">#(s.emoji)</div>
                            <div style="font-size:.9rem;font-weight:600;color:var(--text-primary);margin-bottom:4px;">#(s.title)</div>
                            <div style="font-size:.75rem;color:var(--text-muted);">#(s.reason)</div>
                        </a>
                    #endfor
                    </div>
                </div>
                #endif

                <!-- Certificates -->
                <div style="margin-top: 2.5rem;">
                    <h2 class="account-section-title">Certificates</h2>
                    #if(count(certificates) > 0):
                        <div style="display:flex;flex-direction:column;gap:8px;margin-top:12px;">
                        #for(cert in certificates):
                            <a href="/cert/#(cert.id)" class="account-cert-row">
                                <div class="account-cert-info">
                                    <div class="account-cert-type">#(cert.type)</div>
                                    <div class="account-cert-title">#(cert.title)</div>
                                </div>
                                <div class="account-cert-view">View &rarr;</div>
                            </a>
                        #endfor
                        </div>
                    #else:
                        <div class="account-empty">Complete a course to earn your first certificate!</div>
                    #endif
                </div>
            </div>
        </section>
    #endexport
#endextend
